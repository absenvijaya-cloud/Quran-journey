[{"n":1,"ar":"قُلْ اَعُوْذُ بِرَبِّ النَّاسِۙ","tr":"Katakanlah (Nabi Muhammad), “Aku berlindung kepada Tuhan manusia,","juz":30},{"n":2,"ar":"مَلِكِ النَّاسِۙ","tr":"raja manusia,","juz":30},{"n":3,"ar":"اِلٰهِ النَّاسِۙ","tr":"sembahan manusia","juz":30},{"n":4,"ar":"مِنْ شَرِّ الْوَسْوَاسِ ەۙ الْخَنَّاسِۖ","tr":"dari kejahatan (setan) pembisik yang bersembunyi","juz":30},{"n":5,"ar":"الَّذِيْ يُوَسْوِسُ فِيْ صُدُوْرِ النَّاسِۙ","tr":"yang membisikkan (kejahatan) ke dalam dada manusia,","juz":30},{"n":6,"ar":"مِنَ الْجِنَّةِ وَالنَّاسِ ࣖ ","tr":"dari (golongan) jin dan manusia.”","juz":30}]