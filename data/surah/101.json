[{"n":1,"ar":"اَلْقَارِعَةُۙ","tr":"Al-Qāri‘ah (hari Kiamat yang menggetarkan).","juz":30},{"n":2,"ar":"مَا الْقَارِعَةُ ۚ","tr":"Apakah al-Qāri‘ah itu?","juz":30},{"n":3,"ar":"وَمَآ اَدْرٰىكَ مَا الْقَارِعَةُ ۗ","tr":"Tahukah kamu apakah al-Qāri‘ah itu?","juz":30},{"n":4,"ar":"يَوْمَ يَكُوْنُ النَّاسُ كَالْفَرَاشِ الْمَبْثُوْثِۙ","tr":"Pada hari itu manusia seperti laron yang beterbangan","juz":30},{"n":5,"ar":"وَتَكُوْنُ الْجِبَالُ كَالْعِهْنِ الْمَنْفُوْشِۗ","tr":"dan gunung-gunung seperti bulu yang berhamburan.","juz":30},{"n":6,"ar":"فَاَمَّا مَنْ ثَقُلَتْ مَوَازِيْنُهٗۙ ","tr":"Siapa yang berat timbangan (kebaikan)-nya,","juz":30},{"n":7,"ar":"فَهُوَ فِيْ عِيْشَةٍ رَّاضِيَةٍۗ","tr":"dia berada dalam kehidupan yang menyenangkan.","juz":30},{"n":8,"ar":"وَاَمَّا مَنْ خَفَّتْ مَوَازِيْنُهٗۙ","tr":"Adapun orang yang ringan timbangan (kebaikan)-nya,","juz":30},{"n":9,"ar":"فَاُمُّهٗ هَاوِيَةٌ  ۗ","tr":"tempat kembalinya adalah (neraka) Hawiyah.","juz":30},{"n":10,"ar":"وَمَآ اَدْرٰىكَ مَا هِيَهْۗ","tr":"Tahukah kamu apakah (neraka Hawiyah) itu?","juz":30},{"n":11,"ar":"نَارٌ حَامِيَةٌ ࣖ","tr":"(Ia adalah) api yang sangat panas.","juz":30}]