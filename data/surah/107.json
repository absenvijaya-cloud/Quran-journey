[{"n":1,"ar":"اَرَءَيْتَ الَّذِيْ يُكَذِّبُ بِالدِّيْنِۗ","tr":"Tahukah kamu (orang) yang mendustakan agama?","juz":30},{"n":2,"ar":"فَذٰلِكَ الَّذِيْ يَدُعُّ الْيَتِيْمَۙ","tr":"Itulah orang yang menghardik anak yatim","juz":30},{"n":3,"ar":"وَلَا يَحُضُّ عَلٰى طَعَامِ الْمِسْكِيْنِۗ","tr":"dan tidak menganjurkan untuk memberi makan orang miskin.","juz":30},{"n":4,"ar":"فَوَيْلٌ لِّلْمُصَلِّيْنَۙ","tr":"Celakalah orang-orang yang melaksanakan salat,","juz":30},{"n":5,"ar":"الَّذِيْنَ هُمْ عَنْ صَلَاتِهِمْ سَاهُوْنَۙ","tr":"(yaitu) yang lalai terhadap salatnya,761)","juz":30},{"n":6,"ar":"الَّذِيْنَ هُمْ يُرَاۤءُوْنَۙ","tr":"yang berbuat riya,762)","juz":30},{"n":7,"ar":"وَيَمْنَعُوْنَ الْمَاعُوْنَ ࣖ","tr":"dan enggan (memberi) bantuan.","juz":30}]