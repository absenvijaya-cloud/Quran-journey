[{"n":1,"ar":"اَلَمْ نَشْرَحْ لَكَ صَدْرَكَۙ","tr":"Bukankah Kami telah melapangkan dadamu (Nabi Muhammad),","juz":30},{"n":2,"ar":"وَوَضَعْنَا عَنْكَ وِزْرَكَۙ","tr":"meringankan beban (tugas-tugas kenabian) darimu","juz":30},{"n":3,"ar":"الَّذِيْٓ اَنْقَضَ ظَهْرَكَۙ","tr":"yang memberatkan punggungmu,","juz":30},{"n":4,"ar":"وَرَفَعْنَا لَكَ ذِكْرَكَۗ","tr":"dan meninggikan (derajat)-mu (dengan selalu) menyebut-nyebut (nama)-mu?","juz":30},{"n":5,"ar":"فَاِنَّ مَعَ الْعُسْرِ يُسْرًاۙ","tr":"Maka, sesungguhnya beserta kesulitan ada kemudahan.","juz":30},{"n":6,"ar":"اِنَّ مَعَ الْعُسْرِ يُسْرًاۗ","tr":"Sesungguhnya beserta kesulitan ada kemudahan.","juz":30},{"n":7,"ar":"فَاِذَا فَرَغْتَ فَانْصَبْۙ","tr":"Apabila engkau telah selesai (dengan suatu kebajikan), teruslah bekerja keras (untuk kebajikan yang lain)","juz":30},{"n":8,"ar":"وَاِلٰى رَبِّكَ فَارْغَبْ ࣖ","tr":"dan hanya kepada Tuhanmu berharaplah!","juz":30}]