[{"n":1,"ar":"وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةٍۙ","tr":"Celakalah setiap pengumpat lagi pencela","juz":30},{"n":2,"ar":" ۨالَّذِيْ جَمَعَ مَالًا وَّعَدَّدَهٗۙ","tr":"yang mengumpulkan harta dan menghitung-hitungnya.","juz":30},{"n":3,"ar":"يَحْسَبُ اَنَّ مَالَهٗٓ اَخْلَدَهٗۚ","tr":"Dia (manusia) mengira bahwa hartanya dapat mengekalkannya.","juz":30},{"n":4,"ar":"كَلَّا لَيُنْۢبَذَنَّ فِى الْحُطَمَةِۖ","tr":"Sekali-kali tidak! Pasti dia akan dilemparkan ke dalam (neraka) Hutamah.","juz":30},{"n":5,"ar":"وَمَآ اَدْرٰىكَ مَا الْحُطَمَةُ ۗ","tr":"Tahukah kamu apakah (neraka) Hutamah?","juz":30},{"n":6,"ar":"نَارُ اللّٰهِ الْمُوْقَدَةُۙ","tr":"(Ia adalah) api (azab) Allah yang dinyalakan","juz":30},{"n":7,"ar":"الَّتِيْ تَطَّلِعُ عَلَى الْاَفْـِٕدَةِۗ","tr":"yang (membakar) naik sampai ke hati.","juz":30},{"n":8,"ar":"اِنَّهَا عَلَيْهِمْ مُّؤْصَدَةٌۙ","tr":"Sesungguhnya dia (api itu) tertutup rapat (sebagai hukuman) atas mereka,","juz":30},{"n":9,"ar":"فِيْ عَمَدٍ مُّمَدَّدَةٍ ࣖ","tr":"(sedangkan mereka) diikat pada tiang-tiang yang panjang.","juz":30}]